version = 0.1

# Copy this file to samconfig.toml and change `region` (and stack_name if you prefer).
# samconfig.toml is gitignored so your personal config never gets committed.
#
# Deploy with ./deploy.sh dev  or  ./deploy.sh prod — not bare `sam deploy`.
#
# There are deliberately no parameter_overrides here. `sam deploy
# --parameter-overrides` REPLACES this file's list rather than merging with it, so
# splitting the parameters across both places would mean every deploy silently
# dropped half of them. deploy.sh owns the complete set and reads every
# environment-specific value from SSM. Create these before your first deploy:
#
#   aws ssm put-parameter --name /brief/S3_BUCKET --type String \
#       --value 'your-bucket-name'
#   aws ssm put-parameter --name /brief/GOOGLE_API_KEY --type SecureString \
#       --value 'your-gemini-key'
#   aws ssm put-parameter --name /brief/prod/CLOUDFRONT_DIST_ID --type String \
#       --value 'EXXXXXXXXXXXX'          # prod only; dev skips invalidation
#
# Only if LlmProvider=anthropic (Claude API via workload identity federation —
# see README). Values come from Claude Console → Settings → Workload identity:
#
#   aws ssm put-parameter --name /brief/ANTHROPIC_ORGANIZATION_ID --type String \
#       --value '00000000-0000-0000-0000-000000000000'
#   aws ssm put-parameter --name /brief/ANTHROPIC_SERVICE_ACCOUNT_ID --type String \
#       --value 'svac_...'
#   aws ssm put-parameter --name /brief/ANTHROPIC_WORKSPACE_ID --type String \
#       --value 'wrkspc_...'
#   aws ssm put-parameter --name /brief/dev/ANTHROPIC_FEDERATION_RULE_ID  --type String --value 'fdrl_...'
#   aws ssm put-parameter --name /brief/prod/ANTHROPIC_FEDERATION_RULE_ID --type String --value 'fdrl_...'

# ── Dev (default) ─────────────────────────────────────────────────────────────
# Deploys to brief-dev/ S3 prefix. EventBridge rule is DISABLED.
# Validate with: ./deploy.sh dev && aws lambda invoke --function-name brief-orchestrator-dev ...

[default.global.parameters]
stack_name    = "brief-dev"
region        = "us-west-2"          # change to your region
capabilities  = "CAPABILITY_IAM"
resolve_s3    = true
s3_prefix     = "brief-sam-builds"

[default.deploy.parameters]
confirm_changeset = false
fail_on_empty_changeset = false

# ── Prod ──────────────────────────────────────────────────────────────────────
# Deploys to brief/ S3 prefix (the live site). EventBridge rule ENABLED.
# Only promote after a successful dev run.

[prod.global.parameters]
stack_name    = "brief-prod"
region        = "us-west-2"          # change to your region
capabilities  = "CAPABILITY_IAM"
resolve_s3    = true
s3_prefix     = "brief-sam-builds"

[prod.deploy.parameters]
confirm_changeset = false
fail_on_empty_changeset = false
